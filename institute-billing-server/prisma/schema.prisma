datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. Tenant & Organization (Multi-tenancy foundation)
// ----------------------------------------------------
model Tenant {
  id          String   @id @default(uuid())
  name        String   // e.g. "Nimas Fashion Academy"
  slug        String   @unique
  tagline     String?
  logoUrl     String?
  phone       String?
  email       String?
  address     String?  @db.Text
  currency    String   @default("LKR")
  timezone    String   @default("Asia/Colombo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  settings     Setting[]
  users        User[]
  courses      Course[]
  students     Student[]
  discounts    Discount[]
  enrollments  Enrollment[]
  invoices     Invoice[]
  payments     Payment[]
  smsLogs      SmsLog[]
  auditLogs    AuditLog[]

  @@map("tenants")
}

// ----------------------------------------------------
// 2. Settings (Dynamic SaaS configuration engine)
// ----------------------------------------------------
model Setting {
  id          String   @id @default(uuid())
  tenantId    String
  key         String   // e.g. "student_id_prefix", "reminder_days_before_due", "invoice_footer", etc.
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("settings")
}

// ----------------------------------------------------
// 3. User & Staff Management
// ----------------------------------------------------
enum UserRole {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  STAFF
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         UserRole  @default(ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("users")
}

// ----------------------------------------------------
// 4. Courses & Installment Schemes
// ----------------------------------------------------
enum CourseStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Course {
  id           String       @id @default(uuid())
  tenantId     String
  code         String       // e.g. "NFA-FD01"
  name         String       // e.g. "Fashion Design Diploma"
  description  String?      @db.Text
  thumbnailUrl String?      @db.Text
  basePrice    Decimal      @db.Decimal(12, 2) // in LKR
  duration     String?      // e.g. "6 Months"
  status       CourseStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schemes      CourseInstallmentScheme[]
  enrollments  Enrollment[]

  @@unique([tenantId, code])
  @@map("courses")
}

model CourseInstallmentScheme {
  id                   String   @id @default(uuid())
  courseId             String
  name                 String   // e.g. "Standard 3-Part Scheme"
  numberOfInstallments Int      @default(3)
  breakdownJson        String   @db.Text // JSON array of [{ step: 1, amount: 10000, daysAfterEnrollment: 0, title: "1st Installment" }, ...]
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  course               Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_installment_schemes")
}

// ----------------------------------------------------
// 5. Dynamic Discounts
// ----------------------------------------------------
enum DiscountType {
  FIXED
  PERCENTAGE
}

model Discount {
  id          String       @id @default(uuid())
  tenantId    String
  name        String       // e.g. "Previous Student Discount", "Early Bird"
  code        String?      // e.g. "RETURNING5K"
  type        DiscountType @default(FIXED)
  value       Decimal      @db.Decimal(12, 2) // e.g. 5000 (fixed) or 10.00 (percent)
  reason      String?      @db.Text
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appliedTo   EnrollmentDiscount[]

  @@map("discounts")
}

// ----------------------------------------------------
// 6. Student (Comprehensive Student Profile)
// ----------------------------------------------------
model Student {
  id          String   @id @default(uuid())
  tenantId    String
  studentId   String   // e.g. "NFA-000001" (Generated dynamically from tenant settings)
  firstName   String
  lastName    String?
  mobile      String
  email       String?
  nic         String?  // National Identity Card
  address     String?  @db.Text
  age         Int?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  invoices    Invoice[]
  payments    Payment[]

  @@unique([tenantId, studentId])
  @@index([tenantId, mobile])
  @@index([tenantId, nic])
  @@index([tenantId, email])
  @@map("students")
}

// ----------------------------------------------------
// 7. Enrollment & Invoicing
// ----------------------------------------------------
enum PaymentPlanType {
  FULL_PAYMENT
  INSTALLMENT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
  DROPPED
}

model Enrollment {
  id              String           @id @default(uuid())
  tenantId        String
  studentId       String
  courseId        String
  enrolledAt      DateTime         @default(now())
  originalPrice   Decimal          @db.Decimal(12, 2)
  discountTotal   Decimal          @default(0) @db.Decimal(12, 2)
  finalPrice      Decimal          @db.Decimal(12, 2)
  paymentPlanType PaymentPlanType  @default(FULL_PAYMENT)
  status          EnrollmentStatus @default(ACTIVE)
  notes           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  discounts       EnrollmentDiscount[]
  paymentPlan     PaymentPlan?
  invoice         Invoice?
  payments        Payment[]

  @@map("enrollments")
}

model EnrollmentDiscount {
  id           String   @id @default(uuid())
  enrollmentId String
  discountId   String?
  name         String
  amount       Decimal  @db.Decimal(12, 2)
  reason       String?  @db.Text
  appliedAt    DateTime @default(now())

  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  discount     Discount?  @relation(fields: [discountId], references: [id], onDelete: SetNull)

  @@map("enrollment_discounts")
}

// ----------------------------------------------------
// 8. Payment Plan & Installments Schedule
// ----------------------------------------------------
enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model PaymentPlan {
  id                   String          @id @default(uuid())
  enrollmentId         String          @unique
  type                 PaymentPlanType @default(INSTALLMENT)
  totalAmount          Decimal         @db.Decimal(12, 2)
  numberOfInstallments Int             @default(1)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  enrollment           Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  installments         Installment[]

  @@map("payment_plans")
}

model Installment {
  id                String            @id @default(uuid())
  paymentPlanId     String
  installmentNumber Int               // 1, 2, 3...
  title             String            // e.g. "Installment #1 (Initial)"
  expectedAmount    Decimal           @db.Decimal(12, 2)
  paidAmount        Decimal           @default(0) @db.Decimal(12, 2)
  dueDate           DateTime?         // Nullable for full payment or flexible
  status            InstallmentStatus @default(PENDING)
  paidAt            DateTime?
  notes             String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  paymentPlan       PaymentPlan       @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  payments          Payment[]

  @@map("installments")
}

// ----------------------------------------------------
// 9. Invoice
// ----------------------------------------------------
enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  invoiceNumber String        // e.g. "INV-2026-000001"
  enrollmentId  String        @unique
  studentId     String
  subtotal      Decimal       @db.Decimal(12, 2)
  discountTotal Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  balance       Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(UNPAID)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment    Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@unique([tenantId, invoiceNumber])
  @@map("invoices")
}

// ----------------------------------------------------
// 10. Payments & Receipts
// ----------------------------------------------------
enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String
  paymentNumber String        // e.g. "REC-2026-000001"
  invoiceId     String
  studentId     String
  enrollmentId  String
  installmentId String?
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(CASH)
  reference     String?       // Cheque no, bank ref, card auth
  notes         String?       @db.Text
  paidAt        DateTime      @default(now())
  receivedBy    String?       // Staff name / user id
  createdAt     DateTime      @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment    Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  installment   Installment?  @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, paymentNumber])
  @@index([tenantId, studentId])
  @@index([tenantId, paidAt])
  @@map("payments")
}

// ----------------------------------------------------
// 11. SMS Notification Logs
// ----------------------------------------------------
enum SmsType {
  PAYMENT_RECEIPT
  INSTALLMENT_REMINDER
  ENROLLMENT_CONFIRMATION
  GENERAL
}

enum SmsStatus {
  SENT_MOCK
  SENT
  FAILED
}

model SmsLog {
  id              String    @id @default(uuid())
  tenantId        String
  recipientMobile String
  recipientName   String?
  message         String    @db.Text
  type            SmsType   @default(PAYMENT_RECEIPT)
  status          SmsStatus @default(SENT_MOCK)
  metadataJson    String?   @db.Text
  createdAt       DateTime  @default(now())

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, recipientMobile])
  @@map("sms_logs")
}

// ----------------------------------------------------
// 12. Audit Logs
// ----------------------------------------------------
model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  action      String   // e.g. "PAYMENT_RECORDED", "DISCOUNT_APPLIED", "SETTINGS_UPDATED"
  entity      String   // e.g. "Payment", "Enrollment", "Setting"
  entityId    String?
  performedBy String?  // User email or "ADMIN"
  detailsJson String?  @db.Text
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entity])
  @@map("audit_logs")
}
